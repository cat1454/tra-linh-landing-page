# Public site URL used for canonical links and Supabase magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Safe to expose in the browser. Find these in Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects can use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Configure in Vercel; never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only salt used to hash request identifiers before rate-limit storage.
RATE_LIMIT_SALT=

# Must match the bucket created by the Supabase migration.
SUPABASE_MEDIA_BUCKET=media
